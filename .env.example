# Required when persisting ingested news. Without it, the UI queries live providers.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/world_news?schema=public"

# Optional. NewsAPI is disabled gracefully when unset.
NEWSAPI_KEY=""

# GDELT requires no key. auto enables archive discovery for 7d/30d country
# requests; on always enables it; off explicitly disables it.
GDELT_MODE="auto"
# Legacy compatibility switch. Leave unset when using GDELT_MODE.
GDELT_ENABLED=""

# Use fixtures during ingestion when no live provider returns articles.
NEWS_FIXTURES_ENABLED="false"

# Provider request timeout in milliseconds (2,000-30,000).
NEWS_PROVIDER_TIMEOUT_MS="8000"
# Maximum NEW provider articles processed in one discovery stage (24-150; default 96).
NEWS_LIVE_BATCH_SIZE="96"
# Absolute accumulated relevant-article safety cap (200-2,000; default 1,000).
NEWS_LIVE_CORPUS_LIMIT="1000"
# Period-aware relevant corpus defaults. Each remains bounded by the absolute cap.
NEWS_LIVE_CORPUS_LIMIT_24H="360"
NEWS_LIVE_CORPUS_LIMIT_3D="500"
NEWS_LIVE_CORPUS_LIMIT_7D="750"
NEWS_LIVE_CORPUS_LIMIT_30D="1000"
# Trigger another bounded discovery stage when this many matching stories remain (12-60; default 24).
NEWS_LIVE_LOW_WATER="24"
# Deprecated compatibility alias for NEWS_LIVE_BATCH_SIZE. Leave unset for new deployments.
NEWS_LIVE_ARTICLE_LIMIT=""
# Bounded stored-story candidate window before application ranking (300-5,000; default 1,000).
NEWS_DATABASE_CANDIDATE_LIMIT="1000"
# Database checkpoints older than this are treated as stale for live supplementation.
NEWS_DATABASE_FRESHNESS_MINUTES="120"

# Bounded scheduled-ingestion work per invocation and rotating country shard size.
NEWS_INGESTION_STAGE_LIMIT="24"
NEWS_INGESTION_COUNTRY_BATCH_SIZE="8"

# Optional hybrid semantic clustering. Disabled by default; lexical clustering
# remains deterministic and fully functional without an embedding credential.
NEWS_SEMANTIC_CLUSTERING_ENABLED="false"

# Server-only OpenAI embedding credential. This project-specific key takes
# precedence over the conventional OPENAI_API_KEY when both are present.
# Never expose either credential as NEXT_PUBLIC_*.
NEWS_EMBEDDING_API_KEY=""

# Optional embedding model and request timeout (1,000-15,000 milliseconds).
NEWS_EMBEDDING_MODEL="text-embedding-3-small"
NEWS_EMBEDDING_TIMEOUT_MS="5000"

# Optional JSON array that replaces the default publisher RSS/Atom feeds.
# Never expose this value to the browser and never accept visitor-supplied feed URLs.
RSS_FEEDS_JSON=""
