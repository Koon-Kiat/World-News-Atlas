{
  "name": "world-news-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "dev:next": "next dev",
    "build:next": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "ingest:news": "tsx scripts/ingest-news.ts",
    "ingest:backfill": "tsx scripts/ingest-backfill.ts",
    "diagnose:coverage": "tsx scripts/diagnose-coverage.ts",
    "smoke:coverage": "tsx scripts/diagnose-coverage.ts --smoke",
    "data:update-countries": "tsx scripts/update-country-geography.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply world-news-atlas-d1 --local",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "db:verify:production": "node scripts/migrate-production.mjs --verify"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "flag-icons": "^7.6.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "tldts": "^7.4.19",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20260902.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "braces": "file:vendor/braces",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "miniflare": "^5.20261001.0-alpha",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vinext": "^1.3.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "braces": "$braces",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "miniflare": {
      "sharp": "0.35.5"
    },
    "undici@^7": "^7.30.1",
    "undici@^8": "^8.12.2"
  },
  "type": "module"
}
