generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProviderName {
  NEWSAPI
  GDELT
  RSS
  FIXTURE
  OTHER
}

enum SourceScope {
  LOCAL
  REGIONAL
  NATIONAL
  INTERNATIONAL
}

enum IngestionStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model Country {
  code         String           @id @db.Char(2)
  name         String
  sources      Source[]
  articleLinks ArticleCountry[]
  storyLinks   StoryCountry[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Source {
  id                  String                     @id @default(cuid())
  name                String
  domain              String?                    @unique
  countryCode         String?                    @db.Char(2)
  country             Country?                   @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  region              String?
  language            String?                    @db.VarChar(12)
  scope               SourceScope
  qualityScore        Float                      @default(0.7)
  isActive            Boolean                    @default(true)
  providerIdentifiers SourceProviderIdentifier[]
  articles            Article[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([name, countryCode])
  @@index([countryCode, scope])
}

model SourceProviderIdentifier {
  id         String       @id @default(cuid())
  sourceId   String
  source     Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  provider   ProviderName
  identifier String
  createdAt  DateTime     @default(now())

  @@unique([provider, identifier])
  @@index([sourceId])
}

model Article {
  id                String               @id @default(cuid())
  provider          ProviderName
  providerArticleId String
  title             String
  description       String?              @db.Text
  url               String               @db.Text
  canonicalUrl      String               @unique @db.Text
  imageUrl          String?              @db.Text
  publishedAt       DateTime
  language          String               @db.VarChar(12)
  sourceId          String
  source            Source               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  importanceScore   Float                @default(0.5)
  relevanceScore    Float                @default(0.5)
  countries         ArticleCountry[]
  topics            ArticleTopic[]
  storyLinks        StoryArticle[]
  providerRefs      ArticleProviderRef[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([provider, providerArticleId])
  @@index([publishedAt(sort: Desc)])
  @@index([sourceId, publishedAt(sort: Desc)])
  @@index([language, publishedAt(sort: Desc)])
}

model ArticleProviderRef {
  id                String       @id @default(cuid())
  articleId         String
  article           Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  provider          ProviderName
  providerArticleId String
  createdAt         DateTime     @default(now())

  @@unique([provider, providerArticleId])
  @@index([articleId])
}

model ArticleCountry {
  articleId      String
  countryCode    String  @db.Char(2)
  article        Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  country        Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  relevanceScore Float   @default(0.5)

  @@id([articleId, countryCode])
  @@index([countryCode, articleId])
}

model Topic {
  id           String         @id @default(cuid())
  slug         String         @unique
  label        String
  articleLinks ArticleTopic[]
  storyLinks   StoryTopic[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ArticleTopic {
  articleId String
  topicId   String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([articleId, topicId])
  @@index([topicId, articleId])
}

model Story {
  id               String         @id @default(cuid())
  fingerprint      String         @unique
  title            String
  summary          String?        @db.Text
  firstPublishedAt DateTime
  lastUpdatedAt    DateTime
  importanceScore  Float          @default(0.5)
  clusterScore     Float          @default(0.5)
  articles         StoryArticle[]
  countries        StoryCountry[]
  topics           StoryTopic[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([lastUpdatedAt(sort: Desc)])
  @@index([importanceScore(sort: Desc), lastUpdatedAt(sort: Desc)])
}

model StoryArticle {
  storyId   String
  articleId String
  story     Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([storyId, articleId])
  @@index([articleId])
}

model StoryCountry {
  storyId        String
  countryCode    String  @db.Char(2)
  relevanceScore Float   @default(0.5)
  story          Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  country        Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([storyId, countryCode])
  @@index([countryCode, storyId])
}

model StoryTopic {
  storyId String
  topicId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([storyId, topicId])
  @@index([topicId, storyId])
}

model ProviderIngestionRun {
  id               String          @id @default(cuid())
  provider         ProviderName
  discoveryKey     String          @default("global")
  countryCode      String?         @db.Char(2)
  language         String?         @db.VarChar(12)
  mode             String          @default("incremental") @db.VarChar(24)
  status           IngestionStatus @default(RUNNING)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  windowStart      DateTime?
  windowEnd        DateTime?
  cursor           Json?
  exhausted        Boolean         @default(false)
  coverageComplete Boolean         @default(false)
  lastSuccessfulAt DateTime?
  receivedCount    Int             @default(0)
  normalizedCount  Int             @default(0)
  acceptedCount    Int             @default(0)
  outOfWindowCount Int             @default(0)
  irrelevantCount  Int             @default(0)
  duplicateCount   Int             @default(0)
  storedCount      Int             @default(0)
  storiesUpdated   Int             @default(0)
  errorCode        String?

  @@index([provider, startedAt(sort: Desc)])
  @@index([provider, discoveryKey, startedAt(sort: Desc)])
  @@index([countryCode, windowStart, windowEnd])
}

model ProviderIngestionCheckpoint {
  id               String          @id @default(cuid())
  provider         ProviderName
  discoveryKey     String
  countryCode      String?         @db.Char(2)
  language         String?         @db.VarChar(12)
  mode             String          @default("incremental") @db.VarChar(24)
  status           IngestionStatus @default(RUNNING)
  windowStart      DateTime
  windowEnd        DateTime
  coveredFrom      DateTime?
  coveredTo        DateTime?
  cursor           Json?
  exhausted        Boolean         @default(false)
  coverageComplete Boolean         @default(false)
  receivedCount    Int             @default(0)
  acceptedCount    Int             @default(0)
  duplicateCount   Int             @default(0)
  lastSuccessfulAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([provider, discoveryKey])
  @@index([countryCode, windowStart, windowEnd])
  @@index([status, updatedAt])
}

model IngestionSchedulerState {
  id                String    @id
  nextCountryOffset Int       @default(0)
  lastRunAt         DateTime?
  updatedAt         DateTime  @updatedAt
}
